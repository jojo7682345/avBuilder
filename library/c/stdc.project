inherit compiler = "gcc";
inherit linker = "gcc";
inherit archiver = "ar";
inherit validCextensions = [ ".c", ".C", ".s", ".S" ];

func compileSource(sourceFile, objectFile, flags, includes){
    var retCode;
    var args = [
        "$flags",
        "-I*includes"
    ];
    makeDirs(filePath(objectFile));
    command[retCode] "$compiler -c $sourceFile $args -o $objectFile";
    if(retCode!=0){
        println("compiling " + sourceFile + " failed!");
        return "";
    }
    return objectFile;
}

func compile(sources, outDir, flags, includes){
    var output[arraySize(sources)];
    var failed = 0;
    foreach sourceFile[index] from sources {
        var objectFile = outDir + "/" + fileBaseName(sourceFile) + ".o";
        output[index] = compileSource(sourceFile, objectFile, flags, includes);
        if(output[index]==""){
            failed = 1;
            continue;
        }
    };
    if(failed){
        return [];
    }
    return output;
}

func requiresRecompile(source, object, dependencies){
    foreach dependency from dependencies {
        if(fileLastModified(dependency) > fileLastModified(object)){
            return 1;
        }
    }
    if(fileLastModified(source) > fileLastModified(object)){
        return 1;
    }
    return 0;
}

func requiresRelink(elf, objects, additionalDependencies){
    var relink;
    foreach dependency from additionalDependencies{
        if(fileLastModified(dependency) > fileLastModified(elf)){
            return 1;
        }
    }
    foreach object from objects{
        if(fileLastModified(object) > fileLastModified(elf)){
            return 1;
        }
    }
    return 0;
}

func recompileSource(source, objectFile, flags, includes, dependencies) {
    if(requiresRecompile(source, objectFile, dependencies)){
        return compileSource(source, objectFile, flags, includes);
    }else{
        return objectFile;
    }
}

func recompile(sources, outDir, flags, includes, additionalDependencies){
    var output[arraySize(sources)];
    var failed;
    foreach sourceFile[index] from sources {
        var objectFile = outDir + "/" + fileBaseName(sourceFile) + ".o";
        var dependencyFile = outDir + "/" + fileBaseName(sourceFile) + ".d";

        var dependencies = parseDependencies(dependencyFile, [objectFile, dependencyFile]);
        
        output[index] = recompileSource(sourceFile, objectFile, flags, includes, dependencies + additionalDependencies);
        if(output[index]==""){
            failed = 1;
            continue;
        }
    };
    if(failed){
        return [];
    }
    return output;
}

func archiveLibrary(outDir, libraryName, flags, objects){
    if(arraySize(objects)==0){
        return [];
    }
    var output;
    var retCode;
    makeDirs(outDir);
    command[retCode] "$archiver $flags $outDir/$libraryName *objects";
    output=outDir + "/" + libraryName;
    if(retCode){
        println("linking " + libraryName + " failed!");
        return [];
    }
    return output;
}

func linkExecutable(objects, outDir, libraryName, flags, libDirs, libs){
    var output;
    var retCode;
    var outputExecutable = outDir + "/" + libraryName;
    command[retCode] "$linker $flags *objects -L*libDirs -l*libs -o $outputExecutable";
    output = libraryName;
    
    if(retCode!=0) {
        println("linking " + libraryName + " failed!");
        return [];
    }
    return output;
}

func buildExecutable(sources, buildDir, compileFlags, linkFlags, includes, libDirs, libs, executableName, outDir){
    var objects = compile(sources, buildDir, compileFlags, includes);
    if(arraySize(objects)==0){
        println("Building " + executableName + " failed");
        return [];
    }
    var executable = linkExecutable(objects, outDir, executableName, linkFlags, libDirs, libs);
    if(arraySize(executable)!=0){ 
        println("Successfully build " + executableName);
        return executable;
    }else{
        println("Building " + executableName + " failed");
        return [];
    }
}

func buildStaticLibrary(sources, buildDir, compileFlags, archiveFlags, includes, additionalObjects, libraryName, outDir){
    var objects = compile(sources, buildDir, compileFlags, includes);
    if(arraySize(objects)==0){
        println("compilation failed");
        return [];
    }
    var totalObjects[arraySize(objects) + arraySize(additionalObjects)];
    foreach object[index] from objects {
        totalObjects[index] = object;
    }
    foreach additionalObject[index] from additionalObjects{
        totalObjects[index + arraySize(objects)] = additionalObject;
    }
    var library = archiveLibrary(outDir, "lib" + libraryName + ".a", archiveFlags, totalObjects);
    if(library){
        return library;
    } 
    println("builing static library " + libraryName + " failed!");
    return [];
}

func getSourceFiles(dir){
    return filter(FILTER_TYPE_ENDS_WITH, validCextensions, files in dir recursive);
}
