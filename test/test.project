inherit compiler = "gcc";

testFunc(arr[]){
    perform{
        lines = [ "1", "1", "2", "2", "3", 4, "4"];

        println(filterUnique(lines));

        writeFileLines("test.txt", filterUnique(lines));
    }
}

test(str, split) {
    perform{
        subStrings = splitString(str, split);
        println(subStrings);
        number = decodeHexNumber("0x80000000");
        println(number);
        hexStr = encodeHexNumber(number);
        println(hexStr);
        chr = getStringChar(hexStr, 2);
        println(chr);
        println(trimString("  aa  d "));

        println(stringContains("test", "ese"));
        println(stringContains("test", "tea"));

    }
}